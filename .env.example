# The Eʋe Table — environment variables
# Everything is OPTIONAL for local development: with no keys, the app serves
# typed mock data and runs/demos fully. Add keys to switch to live services.

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase (data, auth, realtime, storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudinary (food imagery)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Paystack (payments — Mobile Money + card, GHS)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# Google Maps (delivery zones, addresses)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# WhatsApp ordering (E.164 without +, e.g. 233XXXXXXXXX)
# Leave blank to use the brands' real published lines (Giloz 233256844456,
# Sefofo 233554177031); set only to override them.
NEXT_PUBLIC_WHATSAPP_GILOZ=""
NEXT_PUBLIC_WHATSAPP_SEFOFO=""

# Admin login (protects /admin with a username + password prompt)
# Defaults to admin / admin123 when unset. This repo is PUBLIC, so set a strong
# password here in production (e.g. Vercel → Settings → Environment Variables)
# instead of relying on the committed default.
ADMIN_USER="admin"
ADMIN_PASSWORD="admin123"
